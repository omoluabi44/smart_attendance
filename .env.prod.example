# ============================================================================
# FacePass Production Environment Configuration (.env.prod)
# Copy to /opt/facepass/.env.prod on EC2 (or inject via GitHub Actions Secrets)
# ============================================================================

# --- 1. Database (Amazon RDS MySQL 8.0) ---
BDYM_TYPE_STORAGE=db
BDYM_ENV=production
BDYM_MYSQL_HOST=facepass-mysql-production.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
BDYM_MYSQL_USER=facepass_admin
BDYM_MYSQL_PWD=CHANGE_ME_STRONG_RDS_PASSWORD
BDYM_MYSQL_DB=facepass_db

# --- 2. Application Security & CORS ---
SECRET_KEY=CHANGE_ME_RANDOM_64_CHAR_HEX_SECRET
JWT_SECRET_KEY=CHANGE_ME_RANDOM_64_CHAR_JWT_SECRET
CORS_ORIGINS=https://facepass.coursepass.app,https://coursepass.app,https://www.coursepass.app

# --- 3. AWS Rekognition & S3 ---
# Option A (Recommended on EC2): Leave AWS_ACCESS_KEY_ID & AWS_SECRET_ACCESS_KEY blank.
# The attached IAM Instance Profile will supply auto-rotating credentials automatically.
# Option B (Local dev or explicit IAM user): Provide static keys below.
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET_NAME=facepass-files-223784796667
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- 4. CoursePass Real-Time Webhook Integration ---
COURSEPASS_WEBHOOK_URL=https://api.coursepass.app/api/v1/integrations/facepass/attendance-webhook
COURSEPASS_SERVICE_SECRET=CHANGE_ME_SHARED_COURSEPASS_SERVICE_SECRET

# --- 5. SMTP Email Configuration ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# --- 6. Frontend Build/Runtime URL ---
NEXT_PUBLIC_API_URL=https://facepass.coursepass.app/api/v1/
