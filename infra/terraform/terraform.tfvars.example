aws_region           = "us-east-1"
environment          = "production"
project_name         = "facepass"
domain_name          = "facepass.coursepass.app"
ec2_instance_type    = "t3.small"
ec2_root_volume_size = 30
ssh_public_key       = "ssh-ed25519 AAAA... your-ssh-public-key"
allowed_ssh_cidrs    = ["0.0.0.0/0"]

db_instance_class    = "db.t4g.micro"
db_allocated_storage = 20
db_name              = "facepass_db"
db_username          = "facepass_admin"
db_password          = "CHANGE_ME_STRONG_PASSWORD_123!"
db_multi_az          = false

s3_bucket_name       = "facepass-file-prod"
media_retention_days = 1
